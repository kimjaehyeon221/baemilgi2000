{
  "expo": {
    "name": "PUSH TOTAL",
    "slug": "push-total",
    "owner": "magpie221",
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F2EC",
    "scheme": "pushtotal",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "주머니 속 움직임으로 푸쉬업 횟수를 자동으로 세기 위해 동작 센서를 사용합니다."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.magpie221.pushtotal",
      "backgroundColor": "#F4F2EC",
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "주머니 속 움직임으로 푸쉬업 횟수를 자동으로 세기 위해 동작 센서를 사용합니다."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "c28e2156-a87c-4e46-886c-48440d672a0f"
      }
    },
    "platforms": ["ios"]
  }
}
